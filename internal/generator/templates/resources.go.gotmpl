// Code generated by mcpgen v{{ .GeneratorVersion }}. DO NOT EDIT region: mcpgen-owned
package mcpapp

import (
	"github.com/modelcontextprotocol/go-sdk/mcp"
{{- if .Resources }}

	"{{ .Module }}/internal/mcpapp/resources"
{{- end }}
)

// registerResources registers all resources with the server.
//
// The region between the mcpgen markers is owned by mcpgen: `mcpgen add resource`
// inserts new registrations there (AST-aware). Do not hand-edit inside the markers.
func registerResources(server *mcp.Server) {
	// mcpgen:begin resources
{{- range .Resources }}
{{- if .IsTemplate }}
	server.AddResourceTemplate(&mcp.ResourceTemplate{
		Name:        {{ quote .ID }},
		Title:       {{ quote .Title }},
		Description: {{ quote .Description }},
		MIMEType:    {{ quote .MIMEType }},
		URITemplate: {{ quote .URITemplate }},
	}, resources.{{ .GoName }})
{{- else }}
	server.AddResource(&mcp.Resource{
		Name:        {{ quote .ID }},
		Title:       {{ quote .Title }},
		Description: {{ quote .Description }},
		MIMEType:    {{ quote .MIMEType }},
		URI:         {{ quote .URI }},
	}, resources.{{ .GoName }})
{{- end }}
{{- end }}
	// mcpgen:end resources
}
