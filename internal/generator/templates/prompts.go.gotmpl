// Code generated by mcpgen v{{ .GeneratorVersion }}. DO NOT EDIT region: mcpgen-owned
package mcpapp

import (
	"github.com/modelcontextprotocol/go-sdk/mcp"
{{- if .Prompts }}

	"{{ .Module }}/internal/mcpapp/prompts"
{{- end }}
)

// registerPrompts registers all prompts with the server.
//
// The region between the mcpgen markers is owned by mcpgen: `mcpgen add prompt`
// inserts new registrations there (AST-aware). Do not hand-edit inside the markers.
func registerPrompts(server *mcp.Server) {
	// mcpgen:begin prompts
{{- range .Prompts }}
	server.AddPrompt(&mcp.Prompt{
		Name:        {{ quote .ID }},
		Title:       {{ quote .Title }},
		Description: {{ quote .Description }},
{{- if .Arguments }}
		Arguments: []*mcp.PromptArgument{
{{- range .Arguments }}
			{
				Name: {{ quote .Name }},
{{- if .Title }}
				Title: {{ quote .Title }},
{{- end }}
{{- if .Description }}
				Description: {{ quote .Description }},
{{- end }}
{{- if .Required }}
				Required: true,
{{- end }}
			},
{{- end }}
		},
{{- end }}
	}, prompts.{{ .GoName }})
{{- end }}
	// mcpgen:end prompts
}
