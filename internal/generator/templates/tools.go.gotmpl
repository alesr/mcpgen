// Code generated by mcpgen v{{ .GeneratorVersion }}. DO NOT EDIT region: mcpgen-owned
package mcpapp

import (
{{- if .Tools }}
	"encoding/json"
{{- end }}

	"github.com/modelcontextprotocol/go-sdk/mcp"
{{- if .Tools }}

	"{{ .Module }}/internal/mcpapp/tools/handlers"
{{- end }}
)

// registerTools registers all tools with the server.
//
// The region between the mcpgen markers is owned by mcpgen: `mcpgen add tool`
// inserts new registrations there (AST-aware). Do not hand-edit inside the
// markers; if you do, mcpgen refuses to add capabilities until they are restored.
func registerTools(server *mcp.Server) {
	// mcpgen:begin tools
{{- range .Tools }}
	mcp.AddTool(server, &mcp.Tool{
		Name:         {{ quote .ID }},
		Title:        {{ quote .Title }},
		Description:  {{ quote .Description }},
		InputSchema:  json.RawMessage({{ quote .InputSchema }}),
		OutputSchema: json.RawMessage({{ quote .OutputSchema }}),
		Annotations: &mcp.ToolAnnotations{
			ReadOnlyHint:   {{ .ReadOnly }},
			IdempotentHint: {{ .Idempotent }},
		},
	}, handlers.{{ .GoName }})
{{- end }}
	// mcpgen:end tools
}
