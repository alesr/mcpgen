        "type": "object"
      },
      "outputSchema": {
        "type": "object"
      },
      "readOnly": true
    }
  ],
  "prompts": [
    {
      "id": "welcome",
      "title": "Welcome",
      "description": "A friendly welcome prompt."
    }
  ],
  "resources": [
    {
      "id": "readme",
      "title": "Readme",
      "description": "A readme stub resource.",
      "uri": "file:///readme",
      "mimeType": "text/plain",
      "text": "Welcome to your MCP server."
    }
  ],
  "features": {}
}
