{
  "version": 1,
  "server": {
    "name": "example-mcp",
    "title": "example-mcp",
    "version": "0.1.0",
    "module": "example.com/example-mcp",
    "description": "Generated MCP server.",
    "instructions": "Generated MCP server."
  },
  "transport": {
    "type": "stdio",
    "httpPort": 8080
  },
  "protocol": "compat",
  "tools": [
    {
      "id": "greet",
      "title": "Greet",
      "description": "Greets a user with a short welcome.",
